{
  "mcpServers": {
    "websuche": {
      "command": ".venv/bin/python",
      "args": [
        "mcp/ddgs_server.py"
      ],
      "env": {
        "SUCHE_MAX_TREFFER": "8",
        "SUCHE_QUELLEN": "bing, brave, duckduckgo, google, mojeek, startpage, wikipedia, yahoo, yandex",
        "ABRUF_MAX_ZEICHEN": "6000"
      },
      "enabled": true,
      "type": "stdio",
      "allowed_tools": [
        "web_search",
        "read_webpage"
      ],
      "needs_confirmation": []
    }
  }
}
