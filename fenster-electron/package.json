{
  "name": "exe-ai-terminal-fenster-electron",
  "productName": "Exe AI",
  "private": true,
  "version": "0.6.50-r1",
  "description": "The Electron window for the Exe AI service.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bauen": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "packen": "electron-builder --mac --publish never",
    "pack:win": "electron-builder --win --publish never",
    "pack:store": "electron-builder --win appx --publish never",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^25.1.8",
    "@electron/rebuild": "4.2.1"
  },
  "build": {
    "appId": "net.exe-hq.exe-ai-terminal",
    "productName": "Exe AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "adressregel.js",
      "linkclicks.js",
      "kontextmenue.js",
      "preload.js",
      "terminal.js",
      "dienstsuche.js",
      "menueleiste.js",
      "topbar.js",
      "thumbnail.js",
      "updater.js",
      "anzeige/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "../dist/Exe AI",
        "to": "exe-ai-terminal"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "exe-ai-productions",
        "repo": "exe-ai",
        "releaseType": "draft"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "Exe-AI-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "../deploy/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "../deploy/entitlements-electron.plist",
      "entitlementsInherit": "../deploy/entitlements-electron.plist",
      "notarize": false,
      "identity": "13CA82624F5FC964C0B0E079660D784029027173",
      "extraResources": [
        {
          "from": "../deploy/exe",
          "to": "bin/exe"
        },
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        }
      ]
    },
    "dmg": {
      "artifactName": "Exe-AI-${version}-${arch}.dmg"
    },
    "appx": {
      "applicationId": "ExeAI",
      "identityName": "ExeAI.ExeAI",
      "publisher": "CN=962E9CB6-CED5-4B24-A50B-FA4F4C9DCE07",
      "publisherDisplayName": "Exe AI",
      "displayName": "Exe AI",
      "backgroundColor": "transparent",
      "artifactName": "Exe-AI-${version}-${arch}.appx",
      "languages": [
        "en-US",
        "de-DE"
      ],
      "customExtensionsPath": "build/appx-extensions.xml"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../deploy/icon.ico"
    },
    "nsis": {
      "artifactName": "Exe-AI-${version}-${arch}.exe"
    }
  }
}
